#!/usr/bin/env python3
"""mcp-bh - single entrypoint for the MCP security kit.

  mcp-bh enum|probe|call|shadow-scan|safe  ...   (bash + curl tools)
  mcp-bh poison-scan|confirm|discover|fuzz|oob-listener  ...   (python tools)
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
S = os.path.join(ROOT, "scripts")
CMDS = {
    "enum": ("bash", "mcp-enum.sh"), "probe": ("bash", "mcp-probe.sh"),
    "call": ("bash", "mcp-call.sh"), "shadow-scan": ("bash", "mcp-shadow-scan.sh"),
    "safe": ("bash", "mcp-readonly-broker.sh"),
    "discover": (sys.executable, "mcp-discover.py"),
    "fuzz": (sys.executable, "mcp-fuzz.py"),
    "poison-scan": (sys.executable, "mcp-poison-scan.py"),
    "confirm": (sys.executable, "mcp-confirm.py"),
    "oob-listener": (sys.executable, "oob-listener.py"),
}

if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
    print(__doc__)
    sys.exit(2)
interp, script = CMDS[sys.argv[1]]
os.execvp(interp, [interp, os.path.join(S, script)] + sys.argv[2:])
